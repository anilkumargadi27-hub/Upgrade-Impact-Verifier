# UpgradeLens Environment Configuration Example
# Copy to .env for local development

NODE_ENV=development
PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Session Authentication
# In production, use a high-entropy 64+ char random string
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars-long

# Database
# Production / Docker: postgresql://user:password@localhost:5432/upgradelens?schema=public
# Local fallback (PGlite embedded Postgres if no external Postgres running):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upgradelens

# Queue (BullMQ / Redis)
# Production / Render Key Value / Docker: redis://localhost:6379
# Leave empty to use local embedded in-memory queue adapter when Redis is not running
REDIS_URL=redis://localhost:6379

# Runner Execution Boundary
# Options: 'process' (isolated bounded child process workspaces), 'docker' (containerized), 'sandbox' (Render Sandbox API)
RUNNER_TYPE=process

# GitHub Integration (Optional - increases GitHub API rate limit from 60/hr to 5,000/hr)
GITHUB_TOKEN=

# Gemini AI Enrichment (Optional)
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Render API Integration (Optional - for Render Sandboxes execution)
RENDER_API_KEY=
RENDER_WORKSPACE_ID=
