FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Install git and build essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY apps/worker/package*.json ./apps/worker/
COPY apps/web/package*.json ./apps/web/
COPY packages/contracts/package*.json ./packages/contracts/
COPY packages/analyzer/package*.json ./packages/analyzer/
COPY packages/runner/package*.json ./packages/runner/

# Install dependencies
RUN npm ci

# Copy full monorepo source
COPY . .

# Generate Prisma Client and build all packages and applications
RUN npm --workspace=@upgradelens/api run db:generate
RUN npm run build

# Production runtime stage
FROM node:22-bookworm-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    openssl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app

ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

CMD ["npm", "--workspace=@upgradelens/api", "start"]